# ============================================================
#  Fratelanza Chat Management System — VPS deployment configuration
#  Copy this file to .env and fill in the values
#    cp .env.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=fratelanza
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=fratelanza

# --- API server ---
# Generate a long random string (>=32 chars). Example one-liner:
#   openssl rand -hex 48
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars

# Run the seed (creates 6 users, 22 customers, conversations, tags, quick replies)
# Set to "false" after the first successful boot if you don't want it to run again
# (it's idempotent — won't duplicate data — but you can disable it anyway).
RUN_SEED=false

# One-shot: wipe demo conversations/customers/tags and reseed fresh.
# Users + their passwords are preserved. Use this after a seed schema
# change (e.g. fixing bad timestamps), then DELETE this line so a future
# container restart doesn't keep wiping data.
# FORCE_RESEED=true

# --- Web (frontend) ---
# Host port for the app. Bound to 127.0.0.1 by default (HTTPS reverse proxy
# in front). WEB_BIND=0.0.0.0 exposes it publicly over plain HTTP — testing only.
WEB_PORT=17156
WEB_BIND=127.0.0.1

# --- First admin (clean production DB, RUN_SEED=false) ---
# Created once when the users table is empty; ignored afterwards.
ADMIN_EMAIL=admin@fratelanza.com
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_NAME=Administrator

# --- WhatsApp Cloud API (Meta) ---
# Callback URL to paste in Meta:  https://<your-domain>/api/webhooks/whatsapp
# any random string; same value goes in Meta "Verify token"
WHATSAPP_VERIFY_TOKEN=
# Meta App → Settings → Basic → App secret (signature check)
WHATSAPP_APP_SECRET=
# permanent System User token (whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=
# WhatsApp → API Setup → Phone number ID
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0

# --- Optional: messaging providers ---
# Required for the generic /api/webhooks/messenger|instagram JSON hook (sent as X-Webhook-Secret):
# WEBHOOK_SECRET=your_inbound_webhook_secret
# MESSAGING_PROVIDER_URL=https://your-provider.example/send
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Optional: AI customer briefs ---
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_BRIEF_MODEL=gpt-4o-mini
