# HTTPS front door on the VPS host for the chat system (Meta requires HTTPS on
# 443 with a valid certificate for webhooks; 17156 stays on loopback).
#
# 1. Create DNS:  chat.<your-domain>  A  187.124.15.14   (DNS only / grey cloud)
# 2. Save as /etc/nginx/sites-available/chat.<your-domain>, replace the domain,
#    symlink into sites-enabled, then:  nginx -t && certbot --nginx -d chat.<your-domain>
#    (certbot adds the ssl_* lines.)  This is a NEW file — it does not touch
#    crm.fratelanza.com or any other site.

server {
    listen 80;
    listen [::]:80;
    server_name chat.example.com;

    client_max_body_size 25M;

    location / {
        proxy_pass http://127.0.0.1:17156;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
